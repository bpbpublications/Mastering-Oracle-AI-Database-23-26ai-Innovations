
-- Priority Transactions demo

ALTER SYSTEM SET priority_txns_high_wait_target = 5;

CREATE TABLE txn_priority_demo (
    id NUMBER PRIMARY KEY,
    value NUMBER
);

INSERT INTO txn_priority_demo VALUES (1,100);
COMMIT;

ALTER SESSION SET TXN_PRIORITY = LOW;

UPDATE txn_priority_demo
SET value = 200
WHERE id = 1;

ALTER SESSION SET TXN_PRIORITY = HIGH;

UPDATE txn_priority_demo
SET value = 300
WHERE id = 1;

SELECT
    s.sid,
    s.blocking_session,
    s.event
FROM v$session s
WHERE s.blocking_session IS NOT NULL;

SELECT * FROM txn_priority_demo;


-- Graph dependency modeling

CREATE TABLE comp_vertex (
comp_id NUMBER GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
name VARCHAR2(128) NOT NULL,
comp_type VARCHAR2(30) NOT NULL,
criticality VARCHAR2(10),
owner_team VARCHAR2(50)
);

CREATE UNIQUE INDEX comp_vertex_u1 ON comp_vertex(name);

CREATE TABLE comp_dep_edge (
dep_id NUMBER GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
src_name VARCHAR2(128) NOT NULL,
dst_name VARCHAR2(128) NOT NULL,
dep_kind VARCHAR2(30),
created_on DATE DEFAULT SYSDATE
);

CREATE INDEX comp_dep_edge_i1 ON comp_dep_edge(src_name);
CREATE INDEX comp_dep_edge_i2 ON comp_dep_edge(dst_name);

INSERT INTO comp_vertex(name, comp_type, criticality) VALUES ('APP_SVC', 'APP', 'HIGH');
INSERT INTO comp_vertex(name, comp_type, criticality) VALUES ('SCAN_NAME', 'SCAN', 'HIGH');
INSERT INTO comp_vertex(name, comp_type, criticality) VALUES ('SCAN_LSNR_1', 'LISTENER', 'HIGH');
INSERT INTO comp_vertex(name, comp_type, criticality) VALUES ('DB_PROD', 'DB', 'HIGH');
INSERT INTO comp_vertex(name, comp_type, criticality) VALUES ('ASM_PROD', 'ASM', 'HIGH');
INSERT INTO comp_vertex(name, comp_type, criticality) VALUES ('DG_DATA', 'DG', 'HIGH');
INSERT INTO comp_vertex(name, comp_type, criticality) VALUES ('LUN_01', 'LUN', 'HIGH');
INSERT INTO comp_vertex(name, comp_type, criticality) VALUES ('STORAGE_LUNS', 'STORAGE', 'HIGH');

COMMIT;

INSERT INTO comp_dep_edge(src_name, dst_name, dep_kind) VALUES ('APP_SVC', 'SCAN_NAME', 'DNS/TCP');
INSERT INTO comp_dep_edge(src_name, dst_name, dep_kind) VALUES ('SCAN_NAME', 'SCAN_LSNR_1', 'TCP');
INSERT INTO comp_dep_edge(src_name, dst_name, dep_kind) VALUES ('SCAN_LSNR_1', 'DB_PROD', 'TCP');
INSERT INTO comp_dep_edge(src_name, dst_name, dep_kind) VALUES ('DB_PROD', 'ASM_PROD', 'ASM');
INSERT INTO comp_dep_edge(src_name, dst_name, dep_kind) VALUES ('ASM_PROD', 'DG_DATA', 'ASM');
INSERT INTO comp_dep_edge(src_name, dst_name, dep_kind) VALUES ('DG_DATA', 'LUN_01', 'STORAGE');
INSERT INTO comp_dep_edge(src_name, dst_name, dep_kind) VALUES ('LUN_01', 'STORAGE_LUNS', 'STORAGE');

COMMIT;

CREATE PROPERTY GRAPH oracle_stack_graph
VERTEX TABLES (
comp_vertex
KEY (comp_id)
PROPERTIES (name, comp_type, criticality, owner_team)
)
EDGE TABLES (
comp_dep_edge
KEY (dep_id)
SOURCE KEY (src_name) REFERENCES comp_vertex(name)
DESTINATION KEY (dst_name) REFERENCES comp_vertex(name)
PROPERTIES (dep_kind, created_on)
);

SELECT *
FROM GRAPH_TABLE (
oracle_stack_graph
MATCH p = (src) -[d]->{1,20} (dst)
WHERE src.name = 'APP_SVC'
AND dst.name = 'STORAGE_LUNS'
ONE ROW PER STEP (v1, e_step, v2) IN (p)
COLUMNS (
MATCHNUM() AS path_id,
ELEMENT_NUMBER(e_step) AS hop_no,
v1.name AS from_component,
e_step.dep_kind AS dep_kind,
v2.name AS to_component
)
)
ORDER BY path_id, hop_no;

SELECT DISTINCT impacted_component, impacted_type, criticality
FROM GRAPH_TABLE (
oracle_stack_graph
MATCH p = (failed) <-[d]-{1,20} (impacted)
WHERE failed.name = 'DG_DATA'
COLUMNS (
impacted.name AS impacted_component,
impacted.comp_type AS impacted_type,
impacted.criticality AS criticality
)
)
ORDER BY impacted_type, impacted_component;

SELECT *
FROM GRAPH_TABLE (
  oracle_stack_graph
  MATCH (a)-[e]->(b)
  COLUMNS (
    a.name AS source,
    b.name AS target,
    e.dep_kind AS dep_kind
  )
);
